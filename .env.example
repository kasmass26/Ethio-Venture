# Copy this file to .env before running the application.
# Values here are bundled into the client application. Use only the Supabase
# publishable (anon) key; never put service_role, database, or admin secrets here.

# development | staging | production
APP_ENV=development

# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Google Gemini API Key for AI Pitch Deck Analysis
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Optional. Reserve this for OAuth/deep-link work; it is not needed for
# email/password authentication.
# SUPABASE_AUTH_REDIRECT_URL=io.supabase.ethioventure://login-callback
